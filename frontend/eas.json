{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://fitrova-backend.onrender.com",
        "EXPO_PUBLIC_AI_SERVICE_URL": "https://ibeh12-fitrova-ai.hf.space",
        "EXPO_PUBLIC_DEBUG": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://fitrova-backend.onrender.com",
        "EXPO_PUBLIC_AI_SERVICE_URL": "https://ibeh12-fitrova-ai.hf.space",
        "EXPO_PUBLIC_DEBUG": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
