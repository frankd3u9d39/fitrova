# Fitrova Environment Configuration Template
# Copy this file to .env.development and fill in your values
# For staging/production, create .env.staging or .env.production

# Environment: development, staging, or production
EXPO_PUBLIC_ENV=development

# Backend API URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:8082/Fitrova/backend

# YouTube Data API v3 - Get from Google Cloud Console
EXPO_PUBLIC_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# AI Service URL (Python Flask service)
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:5001

# Google OAuth Client ID for Android/iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# Paystack Public Key for payments
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY

# Email Verification API (Optional)
# Get your free API key from: https://www.abstractapi.com/api/email-verification-validation-api
ABSTRACT_API_KEY=your_api_key_here
