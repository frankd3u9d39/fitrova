# Staging Environment Variables
EXPO_PUBLIC_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://staging-api.fitrova.com/backend
EXPO_PUBLIC_YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
EXPO_PUBLIC_AI_SERVICE_URL=https://staging-ai.fitrova.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_STAGING_KEY

# Optional debugging
EXPO_PUBLIC_DEBUG=true