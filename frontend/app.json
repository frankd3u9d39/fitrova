{
  "expo": {
    "name": "fitrova",
    "slug": "fitrova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jam66.fitrova",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fitrova to use the camera to analyze your workout form.",
          "microphonePermission": "Allow Fitrova to use the microphone for recording video form checks.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fitrova to access your photos for form analysis.",
          "cameraPermission": "Allow Fitrova to use the camera to analyze your workout form."
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3e0209f4-36ab-4006-a9aa-1e3c5e07c1ac"
      }
    },
    "owner": "holand455"
  }
}