# Backend Environment Configuration Template
# Copy this file to .env.local and fill in actual values
# Never commit .env.local to version control!

# SMTP Configuration for Email Verification
SMTP_USER="your_smtp_user@example.com"
SMTP_PASS="your_smtp_password"

# YouTube API Configuration - Get from Google Cloud Console
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY_HERE"

# AI Service Configuration - Python Flask service
AI_SERVICE_URL="http://localhost:5001/api/analyze-youtube"

# Database Configuration
DB_HOST="localhost"
DB_NAME="fitrova_db"
DB_USER="root"
DB_PASS=""
DB_PORT="3306"

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_your_secret_key"

# Application Environment
APP_ENV="development"
APP_DEBUG="true"

# Session Configuration
SESSION_SECRET="your_session_secret_key_here"